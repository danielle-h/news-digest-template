# Copy to .env for local runs. Never commit .env.
GEMINI_API_KEY=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional
# MAIL_TO=            (defaults to GMAIL_ADDRESS)
# DIGEST_LANGUAGE=    (English or Hebrew; defaults to English)
# GEMINI_MODEL=       (defaults to gemini-flash-latest)
# GEMINI_FALLBACK_MODEL=  (defaults to gemini-flash-lite-latest)
# ELECTION_SECTION=   (on to add the Elections section)
